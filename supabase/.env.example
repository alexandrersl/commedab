# Secrets lus par config.toml (`env(…)`) et par les Edge Functions ; jamais dans le dépôt.
# `supabase config push` lit ce fichier copié en `supabase/.env`, les fonctions reçoivent les
# leurs par `supabase secrets set --env-file supabase/.env` (specs techniques 5.2, 5.6).

# Resend (SMTP des e-mails du compte, API de l'export) : clé API et adresse d'envoi vérifiée.
RESEND_API_KEY=
SMTP_SENDER_EMAIL=

# Connexion Google (console Google Cloud, client OAuth web).
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# Connexion Apple, en phase B (identifiant de service et secret du compte développeur Apple).
SUPABASE_AUTH_EXTERNAL_APPLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_APPLE_SECRET=
