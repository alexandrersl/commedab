{
  "name": "@commedab/mobile",
  "version": "0.0.0",
  "private": true,
  "description": "Application Expo : écrans et navigation. N'importe jamais PowerSync, n'écrit jamais de SQL.",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "web": "pnpm web:assets && expo start --web",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "build:web": "pnpm web:assets && expo export --platform web",
    "deploy:web": "pnpm build:web && wrangler deploy",
    "web:assets": "node scripts/copy-powersync-assets.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@commedab/data": "workspace:*",
    "expo": "~58.0.19",
    "expo-constants": "~58.0.13",
    "expo-linking": "~58.0.14",
    "expo-router": "~58.0.26",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "typescript": "~6.0.3",
    "wrangler": "4.153.0"
  }
}
