{
  "name": "@commedab/mobile",
  "version": "0.0.0",
  "private": true,
  "description": "Application Expo : écrans et navigation. N'importe jamais PowerSync, n'écrit jamais de SQL.",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "web": "pnpm web:assets && expo start --web",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "build:web": "pnpm web:assets && expo export --platform web",
    "deploy:web": "pnpm build:web && wrangler deploy",
    "web:assets": "node scripts/web-assets.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@commedab/data": "workspace:*",
    "@expo-google-fonts/fraunces": "^0.4.1",
    "@expo-google-fonts/manrope": "^0.4.3",
    "@supabase/supabase-js": "^2.118.0",
    "expo": "~58.0.19",
    "expo-constants": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-haptics": "~58.0.7",
    "expo-linking": "~58.0.14",
    "expo-router": "~58.0.26",
    "expo-status-bar": "~58.0.4",
    "nativewind": "^4.2.7",
    "phosphor-react-native": "^3.0.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-css-interop": "0.2.7",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "babel-preset-expo": "~58.0.20",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.3",
    "wrangler": "4.153.0"
  }
}
