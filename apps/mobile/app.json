{
  "expo": {
    "name": "Commedab",
    "slug": "commedab",
    "version": "0.0.0",
    "orientation": "portrait",
    "icon": "../../assets/brand/png/icon-1024.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.commedab"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "../../assets/brand/png/adaptive-foreground-1024.png",
        "backgroundColor": "#0E5B46",
        "monochromeImage": "../../assets/brand/png/adaptive-foreground-1024.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.commedab"
    },
    "web": {
      "favicon": "../../assets/brand/png/favicon-48.png",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "../../assets/brand/png/splash-icon-1024.png",
          "imageWidth": 200,
          "backgroundColor": "#F3EDE3"
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "organization": "alexandre-roussel",
          "project": "commedab"
        }
      ]
    ],
    "scheme": "commedab",
    "experiments": {
      "typedRoutes": true
    }
  }
}
