# Copier en .env et renseigner. Seules des valeurs PUBLIQUES vont ici :
# les clés secrètes (service_role, JWT secret, mot de passe Postgres,
# Client secret Google) restent dans le gestionnaire de mots de passe et
# les secrets GitHub Actions.

# Supabase (Project Settings > API)
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# PowerSync (instance > Instance URL)
EXPO_PUBLIC_POWERSYNC_URL=https://xxxxxxxx.powersync.journeyapps.com

# Sentry (Project Settings > Client Keys)
EXPO_PUBLIC_SENTRY_DSN=https://xxxx@xxxx.ingest.de.sentry.io/xxxx

# Environnement : dev | prod
EXPO_PUBLIC_APP_ENV=dev
